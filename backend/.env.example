AWS_REGION=us-east-1
# Bucket name carries the account-id (and environment) suffix — list existing buckets
# with `aws s3 ls` to confirm. Examples: emip-artifacts-dev-479752407378
S3_BUCKET=emip-artifacts-dev-479752407378
DYNAMODB_JOBS_TABLE=emip-jobs-dev
DYNAMODB_ANALYSIS_TABLE=emip-analysis-dev
BEDROCK_MODEL_PRIMARY=amazon.nova-pro-v1:0
BEDROCK_MODEL_FALLBACK=amazon.nova-lite-v1:0
BEDROCK_MODEL_CODEGEN=amazon.nova-pro-v1:0
MAX_UPLOAD_SIZE_MB=100
FRONTEND_URL=http://localhost:5173
# Comma-separated CORS origins — hosted frontend + localhost dev
CORS_ORIGINS=http://emip-frontend-479752407378.s3-website-us-east-1.amazonaws.com,http://localhost:5173,http://localhost:3000
EMIP_API_KEY=

# Cognito authentication (default off). Point these at the user pool + app
# client created by the SAM template (or an existing pool) and set
# EMIP_COGNITO_ENABLED=true to enforce bearer-token auth.
# EMIP_COGNITO_ENABLED=false
# EMIP_COGNITO_USER_POOL_ID=
# EMIP_COGNITO_REGION=us-east-1
# EMIP_COGNITO_CLIENT_ID=

# Staging (live demo) values — copy this block to point a local backend at the
# deployed staging resources (account 479752407378). Deployed Lambdas get these
# from the SAM template, not from this file.
# S3_BUCKET=emip-artifacts-staging-479752407378
# DYNAMODB_JOBS_TABLE=emip-jobs-staging
# DYNAMODB_ANALYSIS_TABLE=emip-analysis-staging
# ENVIRONMENT=staging
