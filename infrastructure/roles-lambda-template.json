{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "EMIP IAM + Lambda test",
  "Parameters": {
    "Environment": {"Type": "String", "Default": "dev"},
    "LogLevel": {"Type": "String", "Default": "INFO"},
    "DynamoDBJobsTable": {"Type": "String", "Default": "emip-jobs-dev"},
    "DynamoDBAnalysisTable": {"Type": "String", "Default": "emip-analysis-dev"},
    "ApiKey": {"Type": "String", "Default": "", "NoEcho": true}
  },
  "Resources": {
    "BackendFunctionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [{"Action": ["sts:AssumeRole"], "Effect": "Allow", "Principal": {"Service": ["lambda.amazonaws.com"]}}]
        },
        "ManagedPolicyArns": [
          "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole",
          "arn:aws:iam::aws:policy/AWSXrayWriteOnlyAccess"
        ],
        "Policies": [
          {
            "PolicyName": "BackendFunctionRolePolicy0",
            "PolicyDocument": {
              "Statement": [{"Effect": "Allow", "Action": ["s3:GetObject","s3:PutObject","s3:DeleteObject","s3:ListBucket"], "Resource": ["arn:aws:s3:::emip-artifacts","arn:aws:s3:::emip-artifacts/*"]}]
            }
          }
        ],
        "Tags": [{"Key": "lambda:createdBy", "Value": "SAM"}]
      }
    },
    "BackendFunction": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "Code": {
          "S3Bucket": "aws-sam-cli-managed-default-samclisourcebucket-vsdazhrg2kjh",
          "S3Key": "9467114dfd66cecce5234f24ca77158b"
        },
        "Handler": "handler.handler",
        "Runtime": "python3.14",
        "FunctionName": {"Fn::Sub": "emip-backend-${Environment}"},
        "Role": {"Fn::GetAtt": ["BackendFunctionRole", "Arn"]},
        "MemorySize": 1024,
        "Timeout": 120
      }
    }
  }
}
